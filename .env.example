# Copy this file to `.env` and fill in real values.
# These variables are loaded by Ava via AppConfig in src/ava/config.py

# --- Core configuration ---
# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Postgres connection string
# Example (psycopg / SQLAlchemy URL):
# postgresql+psycopg://user:password@localhost:5432/ava
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ava

# Environment name (development | staging | production)
AVA_ENV=development

# --- LLM / embeddings (for later phases) ---
# Gemini API key used for LLM calls and embeddings
GEMINI_API_KEY=your-gemini-api-key-here

# --- Google Calendar (for later phases) ---
# Path to Google service account or OAuth credentials JSON file
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/google-credentials.json
