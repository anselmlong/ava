# ===========================================
# Ava - Agentic AI Telegram Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ----------------
# Application
# ----------------
APP_NAME=ava
# development, staging, production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ----------------
# Telegram Bot
# ----------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
# Admins can approve/reject users and access admin commands
# Find your ID by messaging @userinfobot on Telegram
TELEGRAM_ADMIN_IDS=123456789,987654321

# ----------------
# Database (PostgreSQL)
# ----------------
DATABASE_URL=postgresql+asyncpg://ava:ava_dev_password@localhost:5432/ava
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ---------------
# Redis
# ----------------
REDIS_URL=redis://localhost:6379/0

# ----------------
# Google Gemini API
# ----------------
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ----------------
# Rate Limiting
# ----------------
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_ENABLED=true

# ----------------
# Security
# ----------------
# Secret key for encryption - MUST be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-at-least-32-characters-long
